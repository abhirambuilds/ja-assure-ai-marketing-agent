# ==============================================
# JA Assure AI Marketing Agent Environment Variables
# Copy this file to backend/.env for backend configuration
# ==============================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="JA Assure AI Marketing Agent"
API_V1_STR=/api/v1

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (Default: local SQLite database file in data/ja_assure.db)
DATABASE_URL=sqlite:///./data/ja_assure.db

# LLM Providers (Google Gemini)
# Provide your Gemini API key here. If empty, mock/demo provider mode is automatically activated for local testing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Logging
LOG_LEVEL=INFO

# Brand Configurations
DEFAULT_BRANDS=jade,doctorshield,jaguartransit
