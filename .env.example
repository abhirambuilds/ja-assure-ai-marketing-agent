# ==============================================
# JA Assure AI Marketing Agent Environment Variables
# Copy this file to backend/.env for backend configuration
# ==============================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="JA Assure AI Marketing Agent"
API_V1_STR=/api/v1

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================
# Supabase Project Configuration
# ==============================================
# 1. Supabase Project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon / Public API Key
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (Backend Administrative Access)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Frontend-prefixed Supabase credentials (for frontend/.env)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 5. Supabase PostgreSQL Connection String (Session / Transaction Pooler)
# Dashboard -> Project Settings -> Database -> Connection string (URI)
# Direct connection: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Transaction pooler: postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:your_supabase_password_here@db.your_supabase_project_ref.supabase.co:5432/postgres

# ==============================================
# LLM Providers (Groq API)
# ==============================================
# Provide your Groq API key here. If empty, deterministic offline fallback mode is activated.
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# ==============================================
# OpenAI Images API (optional -- used for AI-generated video scene visuals)
# Leave blank to use the clearly-labeled branded fallback card instead of
# real AI-generated images. Get a key at https://platform.openai.com/api-keys
# ==============================================
OPENAI_API_KEY=

# ==============================================
# Hugging Face Inference Providers (optional -- second real AI image vendor)
# Leave HF_TOKEN blank to keep this provider unavailable.
# ==============================================
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
IMAGE_PROVIDER=openai

# ==============================================
# FFmpeg / ffprobe (optional -- only needed if auto-discovery can't find them)
# Auto-discovered from PATH, then (on Windows) common install locations like the
# WinGet package store. Set these only if auto-discovery fails.
# ==============================================
FFMPEG_PATH=
FFPROBE_PATH=

# Logging
LOG_LEVEL=INFO

# Brand Configurations
DEFAULT_BRANDS=jade,doctorshield,jaguartransit
