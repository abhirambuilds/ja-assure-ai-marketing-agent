# ==============================================
# JA Assure AI Marketing Agent Environment Variables
# Copy this file to backend/.env for backend configuration
# ==============================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="JA Assure AI Marketing Agent"
API_V1_STR=/api/v1

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================
# Supabase Project Configuration
# ==============================================
# 1. Supabase Project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon / Public API Key
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (Backend Administrative Access)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Frontend-prefixed Supabase credentials (for frontend/.env)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 5. Supabase PostgreSQL Connection String (Session / Transaction Pooler)
# Dashboard -> Project Settings -> Database -> Connection string (URI)
# Direct connection: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Transaction pooler: postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:your_supabase_password_here@db.your_supabase_project_ref.supabase.co:5432/postgres

# ==============================================
# LLM Providers (Groq API)
# ==============================================
# Provide your Groq API key here. If empty, deterministic offline fallback mode is activated.
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# ==============================================
# Email & Outreach Automation Configuration
# ==============================================
EMAIL_PROVIDER=mock
REAL_EMAIL_ENABLED=false
REAL_PROVIDER_SEND=false

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Gmail OAuth Adapter Boundary
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Logging
LOG_LEVEL=INFO

# Brand Configurations
DEFAULT_BRANDS=jade,doctorshield,jaguartransit
