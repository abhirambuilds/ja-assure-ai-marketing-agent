# ==============================================
# Backend Environment Variables
# Copy to backend/.env
# ==============================================

ENVIRONMENT=development
DEBUG=True
APP_NAME="JA Assure AI Marketing Agent Backend"
API_V1_STR=/api/v1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SQLite database file path (relative to backend execution directory or absolute)
DATABASE_URL=sqlite:///../../data/ja_assure.db

# Gemini API Key (leave blank for local mock/demo provider mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

LOG_LEVEL=INFO
DEFAULT_BRANDS=jade,doctorshield,jaguartransit
